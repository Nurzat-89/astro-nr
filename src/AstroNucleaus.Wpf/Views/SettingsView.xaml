<UserControl x:Class="AstroNucleaus.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AstroNucleaus.Wpf.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,6,24,6" />
        </Style>
        <Style x:Key="Value" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8,20,8,12" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="Settings" />
            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,16" FontSize="14"
                       Text="Download settings. They can be changed in code through AddInfrastructure(options => …)." />

            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Margin="0,0,10,0" />
                        <TextBlock Style="{StaticResource CardTitle}" Text="Download cache" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="Folder" />
                        <TextBox Grid.Column="1" Style="{StaticResource Value}" Text="{Binding CacheDirectory, Mode=OneWay}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Contents" />
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding CacheSize, Mode=OneWay}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Tag="&#xE838;" Content="Open folder" Command="{Binding OpenCacheFolderCommand}" />
                        <Button Style="{StaticResource SecondaryButton}" Tag="&#xE74D;" Content="Clear cache…" Margin="10,0,0,0"
                                Command="{Binding ClearCacheCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" Margin="0,0,10,0" />
                        <TextBlock Style="{StaticResource CardTitle}" Text="Network" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="User-Agent" />
                        <TextBox Grid.Column="1" Style="{StaticResource Value}" Text="{Binding UserAgent, Mode=OneWay}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Request timeout" />
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding Timeout, Mode=OneWay}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="IAEA address" />
                        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding IaeaAddress, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" Margin="0,0,10,0" />
                        <TextBlock Style="{StaticResource CardTitle}" Text="NNDC libraries" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding NndcLibraries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,6,0,8">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBox Style="{StaticResource Value}" Margin="0,2" Text="{Binding ArchiveUrl, Mode=OneWay}"
                                             Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Sublibraries}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
