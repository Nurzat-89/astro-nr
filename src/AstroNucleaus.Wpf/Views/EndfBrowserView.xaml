<UserControl x:Class="AstroNucleaus.Wpf.Views.EndfBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AstroNucleaus.Wpf.ViewModels"
             xmlns:endf="clr-namespace:AstroNucleaus.Application.Endf;assembly=AstroNucleaus.Application"
             xmlns:controls="clr-namespace:AstroNucleaus.Wpf.Controls"
             mc:Ignorable="d" d:DesignWidth="1300" d:DesignHeight="850"
             d:DataContext="{d:DesignInstance Type=vm:EndfBrowserViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AstroNucleaus.Wpf;component/Themes/Tables.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ToolbarCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="Height" Value="34" />
                <Setter Property="FontSize" Value="13" />
            </Style>

        <Style x:Key="GroupItemStyle" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        </Style>

        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,5,16,5" />
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,5,32,5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0,12,0,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar: fields share the width, buttons stay on the right -->
        <Border Style="{StaticResource Card}" Padding="18,10,14,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Tag="&#xE72C;" Content="Refresh" Command="{Binding RefreshCommand}"
                            ToolTip="Reload the libraries of the selected source" />
                    <Button Style="{StaticResource SecondaryButton}" Tag="&#xE838;" Content="Open local file…" Margin="10,0,0,0"
                            Command="{Binding OpenFileCommand}" />
                </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" MinWidth="150" MaxWidth="260" />
                    <ColumnDefinition Width="*" MinWidth="130" MaxWidth="230" />
                    <ColumnDefinition Width="*" MinWidth="110" MaxWidth="210" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1.3*" MinWidth="170" MaxWidth="280" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="Source" FontWeight="SemiBold" />
                    </StackPanel>
                    <ComboBox Style="{StaticResource ToolbarCombo}" ItemsSource="{Binding Sources}"
                              SelectedItem="{Binding SelectedSource}" DisplayMemberPath="Name" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="Library" FontWeight="SemiBold" />
                    </StackPanel>
                    <ComboBox Style="{StaticResource ToolbarCombo}" ItemsSource="{Binding Libraries}"
                              SelectedItem="{Binding SelectedLibrary}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE81E;" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="Sub-library" FontWeight="SemiBold" />
                    </StackPanel>
                    <ComboBox Style="{StaticResource ToolbarCombo}" ItemsSource="{Binding Sublibraries}"
                              SelectedItem="{Binding SelectedSublibrary}" />
                </StackPanel>

                <Border Grid.Column="3" Style="{StaticResource VerticalDivider}" Margin="18,4" />

                <StackPanel Grid.Column="4">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7B8;" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="Material" FontWeight="SemiBold" />
                    </StackPanel>
                    <ComboBox Style="{StaticResource ToolbarCombo}" ItemsSource="{Binding Materials}"
                              SelectedItem="{Binding SelectedMaterial}" IsEnabled="{Binding HasMaterial}" />
                </StackPanel>

            </Grid>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" MinWidth="220" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Isotopes / files -->
            <Border Style="{StaticResource Card}" Padding="14">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="2,0,0,12">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource SecondaryText}" Text="{Binding FileCountText}"
                                   VerticalAlignment="Center" FontSize="12" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="18" Margin="0,0,10,0" />
                        <TextBlock Style="{StaticResource CardTitle}" Text="Isotopes / Files" />
                    </DockPanel>

                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE71C;"
                                ToolTip="Clear filter" Click="OnClearFilter" />
                        <TextBox Style="{StaticResource SearchBox}" Tag="Filter isotopes or files… (e.g. Fe-56)"
                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>

                    <Button DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}" Tag="&#xE896;" Margin="0,10,0,0"
                            Content="Download &amp; open" Command="{Binding DownloadCommand}"
                            ToolTip="Download the selected evaluation (or take it from the cache) and parse it. Double-click works too." />

                    <ProgressBar DockPanel.Dock="Top" Height="3" IsIndeterminate="True" Margin="0,0,0,4"
                                 Visibility="{Binding IsLoadingList, Converter={StaticResource Visibility}}" />

                    <TreeView x:Name="FileTree" ItemsSource="{Binding ElementGroups}" BorderThickness="0" Background="Transparent"
                              ItemContainerStyle="{StaticResource GroupItemStyle}"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              SelectedItemChanged="OnTreeSelectionChanged" MouseDoubleClick="OnTreeDoubleClick" KeyDown="OnTreeKeyDown">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:ElementGroupViewModel}" ItemsSource="{Binding Files}">
                                <TextBlock FontSize="14">
                                    <Run Text="{Binding Symbol, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text="{Binding Count, Mode=OneWay, StringFormat=({0})}" Foreground="{StaticResource TextSecondaryBrush}" />
                                </TextBlock>
                            </HierarchicalDataTemplate>
                            <DataTemplate DataType="{x:Type endf:EndfRemoteFile}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding FileName}" Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" />
                                </Grid>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- Material -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="16,12">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="56" Height="56" CornerRadius="8" Background="{StaticResource AccentLightBrush}"
                                BorderBrush="{StaticResource AccentBorderBrush}" BorderThickness="1">
                            <Grid>
                                <TextBlock Text="{Binding BadgeMassNumber}" FontSize="11" FontWeight="SemiBold" Margin="6,3,0,0"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding BadgeSymbol}" FontSize="24" FontWeight="Bold" Margin="0,8,0,0"
                                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding MaterialTitle}" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding MaterialSubtitle}" Style="{StaticResource SecondaryText}" FontSize="14" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TabControl Grid.Row="1" Style="{StaticResource PageTabControl}" Margin="0,12,0,0">
                    <!-- Cross sections -->
                    <TabItem Header="Cross sections" Tag="&#xE9D2;">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" MinWidth="300" MaxWidth="450" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="3*" MinWidth="300" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource Card}" Padding="6">
                                <DataGrid Style="{StaticResource TableGrid}" ItemsSource="{Binding SelectedMaterial.CrossSections}"
                                          SelectedItem="{Binding SelectedCrossSection}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="MT" Binding="{Binding MT}" Width="48" MinWidth="40" />
                                        <DataGridTextColumn Header="Reaction" Binding="{Binding ReactionName}" Width="*" MinWidth="100" />
                                        <DataGridTextColumn Header="Q (eV)" Binding="{Binding ReactionQValue, StringFormat=G5}" Width="96" MinWidth="70" />
                                        <DataGridTextColumn Header="Points" Binding="{Binding Data.Count, StringFormat=N0}" Width="58" MinWidth="50" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,12,16,8">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <ToggleButton Style="{StaticResource IconButton}" Content="&#xE7C9;"
                                                          IsChecked="{Binding PlotShowReadout}" ToolTip="Show values under the cursor" />
                                            <Button Style="{StaticResource IconButton}" Content="&#xE8A3;" ToolTip="Zoom in (or use the mouse wheel)" Click="OnZoomIn" />
                                            <Button Style="{StaticResource IconButton}" Content="&#xE71F;" ToolTip="Zoom out" Click="OnZoomOut" />
                                            <Button Style="{StaticResource IconButton}" Content="&#xE740;" ToolTip="Fit to data (or double-click the plot)" Click="OnFit" />
                                            <Button Style="{StaticResource IconButton}" Content="&#xE896;" ToolTip="Export" Margin="14,0,0,0" Click="OnOpenMenu">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Save plot as PNG…" Click="OnSaveImage" />
                                                        <MenuItem Header="Export data as CSV…" Command="{Binding ExportCsvCommand}" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Plot options" Click="OnOpenMenu">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Grid lines" IsCheckable="True" IsChecked="{Binding PlotShowGrid}" />
                                                        <MenuItem Header="Data points" IsCheckable="True" IsChecked="{Binding PlotShowMarkers}" />
                                                        <MenuItem Header="Cursor readout" IsCheckable="True" IsChecked="{Binding PlotShowReadout}" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </StackPanel>
                                        <!-- Title first, then the threshold chip; when space runs out the chip is clipped, not the title. -->
                                        <Grid VerticalAlignment="Center" Margin="0,0,8,0" ClipToBounds="True">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE9D2;"
                                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0" />
                                                <TextBlock Style="{StaticResource CardTitle}" Text="{Binding PlotTitle}" ToolTip="{Binding PlotTitle}" />
                                                <Border Style="{StaticResource Chip}" Margin="12,0,0,0"
                                                        Visibility="{Binding ThresholdText, Converter={StaticResource Visibility}}">
                                                    <TextBlock Text="{Binding ThresholdText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </DockPanel>
                                    <controls:CrossSectionPlot x:Name="Plot" Function="{Binding SelectedCrossSection.Data}"
                                                               ShowGrid="{Binding PlotShowGrid}" ShowMarkers="{Binding PlotShowMarkers}"
                                                               ShowReadout="{Binding PlotShowReadout}" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- General information -->
                    <TabItem Header="General information" Tag="&#xE946;">
                        <Grid DataContext="{Binding SelectedMaterial}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource Card}" Padding="20,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource InfoLabel}" Text="Material" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource InfoValue}" Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource InfoLabel}" Text="MAT" />
                                    <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource InfoValue}" Text="{Binding Mat}" />
                                    <TextBlock Grid.Row="0" Grid.Column="4" Style="{StaticResource InfoLabel}" Text="ZA / AWR" />
                                    <TextBlock Grid.Row="0" Grid.Column="5" Style="{StaticResource InfoValue}">
                                        <Run Text="{Binding ZA, Mode=OneWay}" /> / <Run Text="{Binding AtomicWeightRatio, Mode=OneWay, StringFormat=G8}" />
                                    </TextBlock>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource InfoLabel}" Text="Library" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource InfoValue}">
                                        <Run Text="{Binding Description.LibraryName, Mode=OneWay}" />
                                        <Run Text="{Binding Description.LibraryVersion, Mode=OneWay, StringFormat=v{0}}" />
                                    </TextBlock>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource InfoLabel}" Text="Sub-library" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource InfoValue}" Text="{Binding Description.SubLibraryName}" />
                                    <TextBlock Grid.Row="1" Grid.Column="4" Style="{StaticResource InfoLabel}" Text="Format" />
                                    <TextBlock Grid.Row="1" Grid.Column="5" Style="{StaticResource InfoValue}" Text="{Binding Description.FormatVersion, StringFormat=ENDF-{0}}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource InfoLabel}" Text="Laboratory" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource InfoValue}" Text="{Binding Description.Laboratory}" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource InfoLabel}" Text="Evaluated" />
                                    <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource InfoValue}" Text="{Binding Description.EvaluationDate}" />
                                    <TextBlock Grid.Row="2" Grid.Column="4" Style="{StaticResource InfoLabel}" Text="Authors" />
                                    <TextBlock Grid.Row="2" Grid.Column="5" Style="{StaticResource InfoValue}" Text="{Binding Description.Authors}" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource InfoLabel}" Text="Max energy" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource InfoValue}" Text="{Binding Description.MaxEnergy, StringFormat={}{0:0.###E+00} eV}" />
                                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource InfoLabel}" Text="Temperature" />
                                    <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource InfoValue}" Text="{Binding Description.Temperature, StringFormat={}{0} K}" />
                                    <TextBlock Grid.Row="3" Grid.Column="4" Style="{StaticResource InfoLabel}" Text="Fissionable" />
                                    <TextBlock Grid.Row="3" Grid.Column="5" Style="{StaticResource InfoValue}" Text="{Binding Description.IsFissionable}" />
                                </Grid>
                            </Border>
                            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
                                <TextBox Text="{Binding Description.CommentText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                         Background="Transparent" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- Sections -->
                    <TabItem Header="Sections" Tag="&#xE81E;">
                        <Border Style="{StaticResource Card}" Padding="6">
                            <DataGrid Style="{StaticResource TableGrid}" ItemsSource="{Binding SelectedMaterial.Sections}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MF" Binding="{Binding MF}" Width="50" />
                                    <DataGridTextColumn Header="File" Binding="{Binding FileType}" Width="260" />
                                    <DataGridTextColumn Header="MT" Binding="{Binding MT}" Width="60" />
                                    <DataGridTextColumn Header="Reaction" Binding="{Binding ReactionName}" Width="*" />
                                    <DataGridTextColumn Header="Lines" Binding="{Binding LineCount, StringFormat=N0}" Width="80" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </TabItem>

                    <!-- Warnings -->
                    <TabItem Header="{Binding WarningsHeader}" Tag="&#xE7BA;">
                        <Border Style="{StaticResource Card}" Padding="8">
                            <Grid>
                                <ListBox ItemsSource="{Binding Warnings}" BorderThickness="0" Background="Transparent" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding Warnings.Count, Converter={StaticResource InverseVisibility}}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE930;" FontSize="28" HorizontalAlignment="Center"
                                               Foreground="{StaticResource SuccessBrush}" />
                                    <TextBlock Text="No problems found while parsing." Margin="0,8,0,0" Style="{StaticResource SecondaryText}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
