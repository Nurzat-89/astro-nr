<Window x:Class="AstroNucleaus.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AstroNucleaus.Wpf.ViewModels"
        xmlns:views="clr-namespace:AstroNucleaus.Wpf.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        Title="{Binding Title}" Icon="{StaticResource AppLogo}"
        Width="1500" Height="920" MinWidth="1100" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI" FontSize="13"
        Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <DockPanel Grid.Row="0" Grid.Column="0" Margin="10,12,10,10">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,18">
                <Image Source="{StaticResource AppLogo}" Width="28" Height="28" />
                <TextBlock Text="AstroNucleaus" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Margin="14,0,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                       Text="{Binding Version, StringFormat=Version {0}}" />
            <StackPanel>
                <RadioButton Style="{StaticResource NavButton}" Tag="&#xE80A;" Content="ENDF Browser"
                             IsChecked="{Binding SelectedPage, Converter={StaticResource EnumToBoolean}, ConverterParameter=Browser}" />
                <RadioButton Style="{StaticResource NavButton}" Tag="&#xE9D9;" Content="s-Process"
                             IsChecked="{Binding SelectedPage, Converter={StaticResource EnumToBoolean}, ConverterParameter=SProcess}" />
                <RadioButton Style="{StaticResource NavButton}" Tag="&#xE8F1;" Content="Libraries"
                             IsChecked="{Binding SelectedPage, Converter={StaticResource EnumToBoolean}, ConverterParameter=Libraries}" />
                <RadioButton Style="{StaticResource NavButton}" Tag="&#xE7B8;" Content="Materials"
                             IsChecked="{Binding SelectedPage, Converter={StaticResource EnumToBoolean}, ConverterParameter=Materials}" />
                <RadioButton Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Settings"
                             IsChecked="{Binding SelectedPage, Converter={StaticResource EnumToBoolean}, ConverterParameter=Settings}" />
                <RadioButton Style="{StaticResource NavButton}" Tag="&#xE946;" Content="About"
                             IsChecked="{Binding SelectedPage, Converter={StaticResource EnumToBoolean}, ConverterParameter=About}" />
            </StackPanel>
        </DockPanel>

        <!-- Pages -->
        <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,12,0">
            <views:EndfBrowserView DataContext="{Binding Browser}"
                                   Visibility="{Binding DataContext.SelectedPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visibility}, ConverterParameter=Browser}" />
            <views:SProcessView DataContext="{Binding SProcess}"
                                Visibility="{Binding DataContext.SelectedPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visibility}, ConverterParameter=SProcess}" />
            <views:LibrariesView DataContext="{Binding Browser}"
                                 Visibility="{Binding DataContext.SelectedPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visibility}, ConverterParameter=Libraries}" />
            <views:MaterialsView Visibility="{Binding SelectedPage, Converter={StaticResource Visibility}, ConverterParameter=Materials}" />
            <views:SettingsView DataContext="{Binding Settings}"
                                Visibility="{Binding DataContext.SelectedPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visibility}, ConverterParameter=Settings}" />
            <views:AboutView Visibility="{Binding SelectedPage, Converter={StaticResource Visibility}, ConverterParameter=About}" />
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="18,8"
                DataContext="{Binding Browser}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <!-- Busy: progress and cancel -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsBusy, Converter={StaticResource Visibility}}">
                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="0,0,10,0" MaxWidth="420"
                                   TextTrimming="CharacterEllipsis" />
                        <ProgressBar Width="160" Height="6" Value="{Binding Progress}" IsIndeterminate="{Binding IsProgressIndeterminate}" />
                        <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="11" Margin="10,0,0,0"
                                Content="&#xE711;" ToolTip="Cancel" Command="{Binding CancelCommand}" />
                    </StackPanel>
                    <!-- Idle: status with icon -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsBusy, Converter={StaticResource InverseVisibility}}">
                        <TextBlock Margin="0,0,8,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                    <Setter Property="Text" Value="&#xE930;" />
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                            <Setter Property="Text" Value="&#xE7BA;" />
                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" MaxWidth="560" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Status}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding PointCountText, Converter={StaticResource Visibility}}">
                        <Border Style="{StaticResource VerticalDivider}" Margin="16,0" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9D2;" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding PointCountText}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" Margin="0,0,10,0" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding LocationText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
